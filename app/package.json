{
  "name": "devops-programme-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:podcasts && vite",
    "build": "npm run sync:podcasts && npm run check:content && npm run check:assessment && npm run check:diagnostics && npm run check:projects && npm run check:platforms && tsc -b && vite build",
    "preview": "vite preview",
    "sync:podcasts": "node ../scripts/sync-podcast-assets.mjs",
    "check:content": "node ../scripts/check-podcast-language.mjs",
    "check:assessment": "node ../scripts/check-assessment-item-banks.mjs",
    "review:podcast": "node ../scripts/review-podcast-conversation.mjs",
    "check:diagnostics": "node ../scripts/check-diagnostics.mjs",
    "check:projects": "node ../scripts/check-project-contract.mjs",
    "check:platforms": "node ../scripts/check-platform-adapters.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
