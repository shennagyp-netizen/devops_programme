{
  "name": "devops-programme-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:podcasts && vite",
    "build": "npm run sync:podcasts && npm run check:content && npm run check:assessment && npm run check:diagnostics && npm run check:projects && npm run check:platforms && npm run check:hands-on && npm run check:beginner && npm run check:intermediate && npm run check:advanced && npm run check:programme && npm run check:runtime && npm test && tsc -b && vite build",
    "preview": "vite preview",
    "sync:podcasts": "node ../scripts/sync-podcast-assets.mjs",
    "check:content": "node ../scripts/check-podcast-language.mjs",
    "check:assessment": "node ../scripts/check-assessment-item-banks.mjs",
    "review:podcast": "node ../scripts/review-podcast-conversation.mjs",
    "check:diagnostics": "node ../scripts/check-diagnostics.mjs",
    "check:projects": "node ../scripts/check-project-contract.mjs",
    "check:platforms": "node ../scripts/check-platform-adapters.mjs",
    "check:hands-on": "node ../scripts/check-hands-on-contract.mjs",
    "check:beginner": "node ../scripts/check-beginner-completeness.mjs",
    "check:intermediate": "node ../scripts/check-intermediate-completeness.mjs",
    "check:advanced": "node ../scripts/check-advanced-completeness.mjs",
    "check:programme": "node ../scripts/check-programme-completeness.mjs",
    "check:runtime": "node ../scripts/check-runtime-verification-contract.mjs",
    "hands-on:run": "node ../scripts/run-runtime-task.mjs",
    "runtime:run": "node ../scripts/run-runtime-task.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
